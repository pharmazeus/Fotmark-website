# Template only. Real values live in Vercel (Project → Settings → Environment Variables).
# Local: `vercel env pull web/.env.local` (overwrites the file; keep manual overrides in web/.env.development.local).
# Never commit real values: this repo is public. Validated at build time by web/src/env.ts (@t3-oss/env-nextjs).

# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sanity project identifiers (public, not secrets). web/src/env.ts defaults to these same values.
NEXT_PUBLIC_SANITY_PROJECT_ID=s8t1xmk2
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Server only
# Master launch switch. Keep false on localhost and every preview deployment.
SITE_INDEXABLE=false
# HMAC key for short-lived contact-form timing tokens. Generate a random 32-byte value.
CONTACT_FORM_TOKEN_SECRET=
# Optional. The dataset is public, so the site reads published content without a token.
# No Sanity tokens: the dataset is public and read-only from the site (D-039).
# Signs the Sanity publish webhook → /api/revalidate (same value in the Sanity webhook settings). ≥ 32 chars.
SANITY_REVALIDATE_SECRET=
# Resend: sending-only key, separate keys for Production and Preview (`vercel env add … --sensitive`)
RESEND_API_KEY=
CONTACT_TO_EMAIL=fotmark.es@gmail.com
# Must use a domain verified in Resend (sending subdomain, EU region)
CONTACT_FROM_EMAIL="Fotmark Web <web@send.fotmark.es>"

# No Sanity write token anywhere: the seed (studio/scripts/seed.ts) runs with the developer's own
# login: `pnpm --filter studio exec sanity exec scripts/seed.ts --with-user-token -- --dry-run`.
# The Studio config (studio/sanity.config.ts) has the project id and dataset inline; no studio/.env.
